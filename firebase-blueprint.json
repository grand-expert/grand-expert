{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated Firebase user profile mapped to an internal staff role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["Admin", "Sub-Admin / Cashier", "Cashier", "Accountant", "Inventory Officer"] },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Equipment or inventory item available for sale or rent.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 80 },
        "type": { "type": "string", "enum": ["FOR SALE", "FOR RENT"] },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "totalStock": { "type": "number" },
        "availableStock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 80 },
        "code": { "type": "string", "maxLength": 80 },
        "supplier": { "type": "string", "maxLength": 120 },
        "img": { "type": "string", "maxLength": 500000 },
        "images": { "type": "array", "description": "Gallery image URLs or compressed data URIs (max 10)." },
        "lowStockThreshold": { "type": "number" },
        "reorderReminderTiming": { "type": "string", "maxLength": 30 }
      },
      "required": ["title", "price"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile and debt record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "saleId": { "type": "string", "maxLength": 128 },
        "rentalId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 250 },
        "item": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "issueDate": { "type": "string", "maxLength": 40 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "paidAt": { "type": "string", "maxLength": 50 },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentHistory": { "type": "array", "description": "Recorded initial and partial payments (max 100)." },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 60 },
        "staff": { "type": "string", "maxLength": 120 }
      },
      "required": ["name", "phone"]
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "Internal staff user account and role assignment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["Admin", "Sub-Admin / Cashier", "Cashier", "Accountant", "Inventory Officer"] },
        "phone": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] }
      },
      "required": ["name", "email", "role"]
    },
    "SalesRecord": {
      "title": "Sales Record",
      "description": "Sales transaction record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "customer": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "cashier": { "type": "string", "maxLength": 120 },
        "subtotal": { "type": "number" },
        "taxRate": { "type": "number" },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "depositPaid": { "type": "number" },
        "debtAmount": { "type": "number" },
        "issueDate": { "type": "string", "maxLength": 40 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "paymentMethod": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "maxLength": 40 }
      },
      "required": ["customer", "total"]
    },
    "RentalRecord": {
      "title": "Rental Record",
      "description": "Equipment rental record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "customer": { "type": "string", "maxLength": 120 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "item": { "type": "string", "maxLength": 150 },
        "itemName": { "type": "string", "maxLength": 150 },
        "dailyRate": { "type": "number" },
        "totalFee": { "type": "number" },
        "deposit": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 40 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "maxLength": 60 }
      },
      "required": ["status"]
    },
    "ReturnRecord": {
      "title": "Return Record",
      "description": "Item return or damage record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "rentalId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "customer": { "type": "string", "maxLength": 120 },
        "customerName": { "type": "string", "maxLength": 120 },
        "item": { "type": "string", "maxLength": 150 },
        "productName": { "type": "string", "maxLength": 150 },
        "quantity": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "processedBy": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "maxLength": 60 }
      },
      "required": ["date"]
    },
    "CustomerOrder": {
      "title": "Customer Order",
      "description": "Customer order placed on the website.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 60 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 250 },
        "productId": { "type": "string", "maxLength": 128 },
        "productTitle": { "type": "string", "maxLength": 150 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "items": { "type": "array", "description": "Multi-item order cart entries." },
        "orderNotes": { "type": "string", "maxLength": 500 },
        "subtotalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "discountPercent": { "type": "number" },
        "discountReason": { "type": "string", "maxLength": 200 },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 60 },
        "paymentStatus": { "type": "string", "maxLength": 60 },
        "paymentReference": { "type": "string", "maxLength": 150 },
        "paymentInstructions": { "type": "string", "maxLength": 1500 },
        "paymentRequestedAt": { "type": "string", "maxLength": 50 },
        "customerAccepted": { "type": "boolean" },
        "customerAcceptedAt": { "type": "string", "maxLength": 50 },
        "orderDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Processing", "Completed", "Cancelled", "Rejected"] }
      },
      "required": ["customerName", "customerPhone", "totalAmount"]
    },
    "CustomerMessage": {
      "title": "Customer Message",
      "description": "Message thread between customer and administration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "sender": { "type": "string", "enum": ["Customer", "Admin"] },
        "senderName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "subject": { "type": "string", "maxLength": 150 },
        "source": { "type": "string", "maxLength": 40 },
        "text": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" }
      },
      "required": ["sender", "senderName", "text", "timestamp"]
    },
    "UserFile": {
      "title": "User File",
      "description": "Uploaded file metadata in File Vault.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "originalName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "size": { "type": "number" },
        "uploadDate": { "type": "string", "maxLength": 50 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["originalName", "userEmail"]
    },
    "CompanySetting": {
      "title": "Company Setting",
      "description": "Company branding and configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 250 },
        "footer": { "type": "string", "maxLength": 500 },
        "evcNumber": { "type": "string", "maxLength": 60 },
        "edahabNumber": { "type": "string", "maxLength": 60 },
        "merchantNumber": { "type": "string", "maxLength": 80 },
        "bankName": { "type": "string", "maxLength": 120 },
        "bankAccount": { "type": "string", "maxLength": 120 },
        "paymentNumber": { "type": "string", "maxLength": 60 }
      },
      "required": ["name"]
    },
    "SmsSetting": {
      "title": "SMS Setting",
      "description": "SMS gateway configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "provider": { "type": "string", "maxLength": 50 },
        "senderId": { "type": "string", "maxLength": 50 },
        "autoCronEnabled": { "type": "boolean" }
      },
      "required": ["provider"]
    },
    "SiteFrontendContent": {
      "title": "Site Frontend Content",
      "description": "Editable public storefront website copy stored at site_settings/frontend_content.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "heroHeadline": { "type": "string", "maxLength": 150 },
        "heroSubheadline": { "type": "string", "maxLength": 400 },
        "heroPrimaryBtnText": { "type": "string", "maxLength": 80 },
        "heroSecondaryBtnText": { "type": "string", "maxLength": 80 },
        "catalogTitle": { "type": "string", "maxLength": 150 },
        "catalogDescription": { "type": "string", "maxLength": 400 },
        "missionCardSubtitle": { "type": "string", "maxLength": 120 },
        "missionCardTitle": { "type": "string", "maxLength": 150 },
        "missionCardParagraph": { "type": "string", "maxLength": 600 },
        "missionCardBtnText": { "type": "string", "maxLength": 80 },
        "inquiryCardSubtitle": { "type": "string", "maxLength": 120 },
        "inquiryCardTitle": { "type": "string", "maxLength": 150 },
        "inquiryCardDescription": { "type": "string", "maxLength": 600 },
        "inquiryCardBtnText": { "type": "string", "maxLength": 80 },
        "footerDescription": { "type": "string", "maxLength": 500 },
        "footerAddress": { "type": "string", "maxLength": 250 },
        "footerPhone": { "type": "string", "maxLength": 40 },
        "footerEmail": { "type": "string", "maxLength": 150 },
        "footerCopyright": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Firebase authenticated user role mapping"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer list and debt records"
    },
    "/staff_members/{staffId}": {
      "schema": "StaffMember",
      "description": "Internal staff user directory"
    },
    "/sales_history/{saleId}": {
      "schema": "SalesRecord",
      "description": "Completed sales transactions"
    },
    "/rental_history/{rentalId}": {
      "schema": "RentalRecord",
      "description": "Rental records"
    },
    "/returns_history/{returnId}": {
      "schema": "ReturnRecord",
      "description": "Returns records"
    },
    "/customer_orders/{orderId}": {
      "schema": "CustomerOrder",
      "description": "Customer orders submitted on website"
    },
    "/customer_messages/{messageId}": {
      "schema": "CustomerMessage",
      "description": "Customer messaging threads and admin replies"
    },
    "/user_files/{fileId}": {
      "schema": "UserFile",
      "description": "User files metadata"
    },
    "/company_settings/{settingId}": {
      "schema": "CompanySetting",
      "description": "Company settings"
    },
    "/sms_settings/{settingId}": {
      "schema": "SmsSetting",
      "description": "SMS Gateway settings"
    },
    "/site_settings/{settingId}": {
      "schema": "SiteFrontendContent",
      "description": "Public website frontend editable content"
    }
  }
}
